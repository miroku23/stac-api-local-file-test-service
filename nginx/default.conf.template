map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

upstream backend_api {
  server ${NGINX_BACKEND_ALIAS}:${NGINX_BACKEND_PORT};
}

upstream file_manage_app {
  server ${NGINX_FILE_MANAGE_ALIAS}:${NGINX_FILE_MANAGE_PORT};
}

upstream geo_viewer_app {
  server ${NGINX_GEO_VIEWER_ALIAS}:${NGINX_GEO_VIEWER_PORT};
}

upstream stac_api {
  server ${NGINX_STAC_API_ALIAS}:${NGINX_STAC_API_PORT};
}

server {
  listen 80;
  server_name _;
  absolute_redirect off;

  client_max_body_size 500m;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;

  location = / {
    return 302 ${NGINX_FILE_MANAGE_PATH}/;
  }

  location = ${NGINX_FILE_MANAGE_PATH} {
    return 301 ${NGINX_FILE_MANAGE_PATH}/;
  }

  location ${NGINX_FILE_MANAGE_PATH}/ {
    proxy_pass http://file_manage_app;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location = ${NGINX_GEO_VIEWER_PATH} {
    return 301 ${NGINX_GEO_VIEWER_PATH}/;
  }

  location ${NGINX_GEO_VIEWER_PATH}/ {
    proxy_pass http://geo_viewer_app;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location = ${NGINX_STAC_PATH} {
    return 301 ${NGINX_STAC_PATH}/;
  }

  location ${NGINX_STAC_PATH}/ {
    proxy_pass http://stac_api/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix ${NGINX_STAC_PATH};
  }

  location ${NGINX_API_PATH}/events/watch {
    proxy_pass http://backend_api/events/watch;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location = ${NGINX_API_PATH} {
    return 301 ${NGINX_API_PATH}/;
  }

  location ${NGINX_API_PATH}/ {
    proxy_pass http://backend_api/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
