# Copy this file to .env and change values for your machine.
# Docker Compose reads only the root .env file.
# Do not commit .env because it contains user-specific local paths and credentials.

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
# Display/API project name used by the backend.
PROJECT_NAME=Zarr-API

# ---------------------------------------------------------------------------
# Docker host mount paths
# ---------------------------------------------------------------------------
# IMPORTANT:
# These two values are host-machine local paths and are intentionally blank in
# this example for security/privacy. Fill them in your local .env file.
#
# LOCAL_DATA_PATH is mounted to /app/data inside the backend container.
# The backend expects:
#   /app/data/DATA  -> raw/source files
#   /app/data/ZARR  -> converted Zarr outputs
#
# LOCAL_TEMP_PATH is mounted to /app/temp inside the backend container.
# It is used for upload/convert/download temporary files.
#
# LOCAL_PGSTAC_DATA_PATH is mounted to /var/lib/postgresql/data inside the
# pgstac container. Keep it under docker-data/ for local Docker runtime data.
#
# Windows Git Bash / Docker Desktop example:
#   LOCAL_DATA_PATH=/d/OPER/OUTPUT
#   LOCAL_TEMP_PATH=/d/OPER/TEMP
#   LOCAL_PGSTAC_DATA_PATH=./docker-data/pgstac
#
# Linux/macOS example:
#   LOCAL_DATA_PATH=/data/zarr-api/output
#   LOCAL_TEMP_PATH=/data/zarr-api/temp
#   LOCAL_PGSTAC_DATA_PATH=./docker-data/pgstac
#
# Do not wrap paths in quotes.
LOCAL_DATA_PATH=
LOCAL_TEMP_PATH=
LOCAL_PGSTAC_DATA_PATH=./docker-data/pgstac

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# DATA_ROOT_DIR and TEMP_ROOT_DIR are not defined here on purpose.
# They are fixed container paths with backend defaults:
#   DATA_ROOT_DIR=/app/data
#   TEMP_ROOT_DIR=/app/temp
WATCH_INTERVAL=0.5

# Maximum number of Zarr conversion jobs that actually run in parallel inside
# the backend process. The queue can hold up to 5 active/error jobs; this value
# controls execution concurrency only. Keep 2 as the safe default. Use 1 for
# large files or slower disks, and raise only after measuring I/O performance.
ZARR_CONVERT_MAX_WORKERS=2

# Enables recursive polling of the mounted local data root for legacy realtime
# file-change events. Keep disabled unless a client actively subscribes to
# ${NGINX_API_PATH}/events/watch; polling large bind mounts can slow startup.
ENABLE_DATA_WATCH=false

# ---------------------------------------------------------------------------
# Nginx
# ---------------------------------------------------------------------------
# NGINX_PORT is the host port. Browser access is http://localhost:${NGINX_PORT}.
NGINX_PORT=9000

# Route prefixes rendered into nginx/default.conf.template at container start.
# Keep these values without a trailing slash.
#
# NGINX_API_PATH is the single external backend context path.
# Browser requests use paths like:
#   ${NGINX_API_PATH}/monitor/root
#   ${NGINX_API_PATH}/inspect/structure
#   ${NGINX_API_PATH}/events/watch
#   ${NGINX_API_PATH}/data/zarr
#
# Nginx strips this context before forwarding to the backend container.
NGINX_FILE_MANAGE_PATH=/manage
NGINX_GEO_VIEWER_PATH=/viewer
NGINX_API_PATH=/api
NGINX_STAC_PATH=/stac

# Nginx upstream aliases and ports inside the Docker Compose network.
# ALIAS values are registered as Docker network aliases in docker-compose.yml
# and rendered into nginx/default.conf.template.
#
# Do not use localhost here: inside the nginx container, localhost means nginx
# itself, not another Compose service.
#
# PORT values are also used as the internal app ports for each service.
NGINX_BACKEND_ALIAS=backend-api
NGINX_BACKEND_PORT=8000
NGINX_FILE_MANAGE_ALIAS=file-manage-app
NGINX_FILE_MANAGE_PORT=5173
NGINX_GEO_VIEWER_ALIAS=geo-viewer-app
NGINX_GEO_VIEWER_PORT=5174
NGINX_STAC_API_ALIAS=stac-api-upstream
NGINX_STAC_API_PORT=8080

# ---------------------------------------------------------------------------
# Frontend / Vite
# ---------------------------------------------------------------------------
# Set to 1 to enable the optional WebAssembly/WebGL path.
VITE_ENABLE_WEBGL_WASM=0

# ---------------------------------------------------------------------------
# STAC / PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgis

# ---------------------------------------------------------------------------
# External data credentials
# ---------------------------------------------------------------------------
# Fill real values in .env only. Leave this example blank.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
EDL_USERNAME=
EDL_PASSWORD=
